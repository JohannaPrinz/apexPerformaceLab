{
  "$comment": "Performance Design System – maschinenlesbare Tokens. Nutzbar für Tailwind v3 (tailwind.config), CSS-in-JS, Styled Components, React Native oder den Import in Figma.",
  "name": "performance-design-system",
  "version": "1.0.0",
  "color": {
    "canvas": { "value": "#F7F7F5", "use": "Seitenhintergrund" },
    "surface": { "value": "#FFFFFF", "use": "Karten, erhöhte Flächen" },
    "surfaceMuted": { "value": "#F1F1EE", "use": "abgesetzte Blöcke" },
    "deep": { "value": "#16181A", "use": "invertierte Abschnitte" },

    "ink": { "value": "#16181A", "use": "Überschriften" },
    "inkSoft": { "value": "#3D4247", "use": "Fließtext" },
    "inkMuted": { "value": "#71777D", "use": "Sekundärtext ab 16px" },
    "inkMutedAccessible": {
      "value": "#63696F",
      "use": "Sekundärtext unter 16px – erfüllt WCAG AA"
    },

    "line": { "value": "#E4E4DF", "use": "Trennlinien, Rahmen" },
    "lineStrong": { "value": "#D3D3CC", "use": "betonte Rahmen" },

    "accent": { "value": "#1F7A64", "use": "Buttons, Icons, Hervorhebung" },
    "accentStrong": { "value": "#175D4C", "use": "Hover-Zustand" },
    "accentSoft": { "value": "#E8F1EE", "use": "Icon-Flächen" },
    "accentInk": { "value": "#0F3F34", "use": "Text auf accentSoft" }
  },
  "font": {
    "sans": {
      "family": "Inter",
      "use": "Fließtext, Bedienelemente",
      "weights": [400, 500, 600]
    },
    "display": {
      "family": "Manrope",
      "use": "Überschriften",
      "weights": [600, 700]
    },
    "mono": {
      "family": "IBM Plex Mono",
      "use": "Mikro-Labels, Zahlen",
      "weights": [400, 500]
    }
  },
  "letterSpacing": {
    "$comment": "Der Kontrast zwischen negativ bei großer und positiv bei kleiner Schrift trägt den hochwertigen Eindruck.",
    "display": "-0.03em",
    "heading": "-0.022em",
    "body": "0",
    "eyebrow": "0.16em"
  },
  "fontSize": {
    "eyebrow": "0.6875rem",
    "xs": "0.75rem",
    "sm": "0.875rem",
    "base": "1rem",
    "lead": "1.0625rem",
    "lg": "1.125rem",
    "xl": "1.25rem",
    "h3": "1.5rem",
    "h2": "2.75rem",
    "h1": "4.25rem"
  },
  "radius": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "20px",
    "xl": "28px",
    "pill": "999px"
  },
  "space": {
    "$comment": "Vielfache von 0.25rem, wie in Tailwind.",
    "sectionMobile": "5rem",
    "sectionDesktop": "8rem",
    "sectionTightMobile": "4rem",
    "sectionTightDesktop": "5rem",
    "cardPadding": "2rem",
    "cardPaddingDesktop": "2.5rem"
  },
  "width": {
    "narrow": "48rem",
    "default": "72rem",
    "wide": "80rem"
  },
  "motion": {
    "$comment": "Genau eine Kurve für das gesamte Projekt.",
    "ease": "cubic-bezier(0.22, 1, 0.36, 1)",
    "durationFast": "200ms",
    "durationSlow": "700ms"
  },
  "shadow": {
    "$comment": "Nur für schwebende Elemente. Immer weich, mit negativem Spread.",
    "card": "0 24px 48px -32px rgb(22 24 26 / 0.4)",
    "float": "0 12px 32px -16px rgb(22 24 26 / 0.35)",
    "modal": "0 48px 96px -40px rgb(22 24 26 / 0.6)"
  },
  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  }
}
