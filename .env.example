# ─────────────────────────────────────────────────────────────────────────────
# Apex OS — Environment Variables
#
# Copy to `.env` for local development:  cp .env.example .env
# Variables are validated at build & runtime by `apps/web/src/env.ts` (@t3-oss/env).
# A missing or malformed required variable fails the build loudly instead of
# surfacing as an undefined at runtime.
#
# NEXT_PUBLIC_* are inlined into the client bundle — never put secrets there.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# DATABASE_URL is the pooled connection used by the app at runtime.
# DIRECT_URL bypasses the pooler and is used by Prisma Migrate only.
# With a non-pooled Postgres, set both to the same value.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apex_os?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/apex_os?schema=public"

# ── Authentication (Better Auth) ─────────────────────────────────────────────
# Generate a secret:  openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# OAuth providers (optional — leave empty to disable the provider)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Storage (Supabase Storage) ───────────────────────────────────────────────
# The project URL — the same project the database lives in.
SUPABASE_URL=""
# The **service role** key, never the anon key: files are read and written on
# the server after the app has decided who may see what, and the bucket is
# private. Leave empty and the app runs without files.
SUPABASE_SERVICE_ROLE_KEY=""
# One private bucket. Three areas inside it, separated by path:
#   analysis-temp/<organizationId>/<testId>/…  temporary, swept after 14 days
#   reports/<reportId>/…                        frozen with a published analysis
#   athletes/<athleteId>/…                      the athlete's own media
SUPABASE_STORAGE_BUCKET="apex-os"
# Shared secret for the scheduled sweep of analysis-temp/ (see vercel.json).
# Empty and the sweep refuses everything — a delete endpoint must never be open.
CRON_SECRET=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Apex OS <noreply@example.com>"

# ── Background Jobs (Trigger.dev) ────────────────────────────────────────────
TRIGGER_SECRET_KEY=""
TRIGGER_PROJECT_ID=""

# ── Analytics (PostHog) ──────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# ── Feature Flags ────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_ANALYTICS="false"
