# ─────────────────────────────────────────────────────────────────────────────
# Apex OS — Environment Variables
#
# Copy to `.env` for local development:  cp .env.example .env
# Variables are validated at build & runtime by `apps/web/src/env.ts` (@t3-oss/env).
# A missing or malformed required variable fails the build loudly instead of
# surfacing as an undefined at runtime.
#
# NEXT_PUBLIC_* are inlined into the client bundle — never put secrets there.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# DATABASE_URL is the pooled connection used by the app at runtime.
# DIRECT_URL bypasses the pooler and is used by Prisma Migrate only.
# With a non-pooled Postgres, set both to the same value.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apex_os?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/apex_os?schema=public"

# ── Authentication (Better Auth) ─────────────────────────────────────────────
# Generate a secret:  openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# OAuth providers (optional — leave empty to disable the provider)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Storage (Cloudflare R2, S3-compatible) ───────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="apex-os"
# Public base URL of the bucket / custom domain, used to build asset URLs.
R2_PUBLIC_URL=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Apex OS <noreply@example.com>"

# ── Background Jobs (Trigger.dev) ────────────────────────────────────────────
TRIGGER_SECRET_KEY=""
TRIGGER_PROJECT_ID=""

# ── Analytics (PostHog) ──────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# ── Feature Flags ────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_ANALYTICS="false"
