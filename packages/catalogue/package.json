{
  "name": "@apex/catalogue",
  "version": "0.1.0",
  "private": true,
  "description": "Exercise catalogue research: reads external datasets, compares them, and produces candidates. Never writes to the product.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "catalogue:fetch": "tsx scripts/fetch.ts",
    "catalogue:analyse": "tsx scripts/analyse.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf .turbo node_modules dist",
    "catalogue:curate": "tsx scripts/curate.ts",
    "catalogue:review-list": "tsx scripts/review-list.ts",
    "catalogue:review-batches": "tsx scripts/review-batches.ts",
    "catalogue:variants-review": "tsx scripts/variants-review.ts",
    "catalogue:duplicates": "tsx scripts/duplicates.ts",
    "catalogue:build-import": "tsx scripts/build-import.ts"
  },
  "dependencies": {
    "@apex/domain": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@apex/config": "workspace:*",
    "@types/node": "26.1.2",
    "eslint": "9.39.5",
    "rimraf": "6.1.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
